{
  "name": "web-element-picker",
  "displayName": "Web Element Picker",
  "description": "代理任意 Web 服务，选择元素并发送修改请求到 Chat",
  "version": "0.3.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:webPicker.startProxy",
    "onCommand:webPicker.stopProxy",
    "onCommand:webPicker.undo",
    "onCommand:webPicker.debugChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "webPicker.startProxy",
        "title": "Web Picker: Start Proxy (输入目标URL)"
      },
      {
        "command": "webPicker.stopProxy",
        "title": "Web Picker: Stop Proxy"
      },
      {
        "command": "webPicker.undo",
        "title": "Web Picker: Undo Last Modification"
      },
      {
        "command": "webPicker.debugChat",
        "title": "Web Picker: Debug Chat Commands"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/node": "^20.11.0",
    "@types/http-proxy": "^1.17.14",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^3.0.0",
    "ws": "^8.16.0",
    "open": "^8.4.2"
  }
}
